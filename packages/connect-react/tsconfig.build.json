{
  "extends": "../../tsconfig.json",
  // Inputs and outDir come only from release/build-sdk.ts, which extends this file. Run directly, this config has no
  // inputs and fails, instead of writing .js/.d.ts/.map beside every source file of the repository.
  "include": [],
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "sourceRoot": "../src/",
    "rewriteRelativeImportExtensions": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": []
  }
}
