      "./styles.css": "./styles.css"
    },
    "files": [
      "esm",
      "styles.css",
      "CHANGELOG.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "publishConfig": {
      "access": "public",
      "provenance": true
    },
    "name": "@inverus/connect-react",
    "repository": {
      "type": "git",
      "url": "git+https://github.com/InVerus-LLC/sanctum-connect-sdk.git",
      "directory": "packages/connect-react"
    },
    "homepage": "https://github.com/InVerus-LLC/sanctum-connect-sdk/tree/dev/packages/connect-react#readme",
    "bugs": {
      "url": "https://github.com/InVerus-LLC/sanctum-connect-sdk/issues"
    },
    "author": {
      "name": "inVerus"
    },
    "keywords": [
      "sanctum",
      "inverus",
      "react",
      "nextjs",
      "authentication",
      "openid-connect",
      "wallet",
      "sdk"
    ]
  },
  "license": "MIT"
}
