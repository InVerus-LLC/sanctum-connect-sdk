{
  "name": "@inverus/connect-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@inverus/connect": "0.0.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "scripts": {
    "build": "node ../connect/release/build-sdk.ts"
  },
  "sanctumPublish": {
    "version": "0.1.0-alpha.0",
    "description": "React 19 hooks and UI for Sanctum Connect: sign-in, callbacks, in-memory sessions, wallet discovery and pairing.",
    "license": "MIT",
    "private": false,
    "engines": {
      "node": ">=22.15.1"
    },
    "sideEffects": [
      "*.css"
    ],
    "exports": {
      ".": {
        "types": "./esm/index.d.ts",
        "import": "./esm/index.js"
