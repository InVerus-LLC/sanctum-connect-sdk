{
  "name": "sanctum-connect-sdk",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "26.13.1"
  },
  "workspaces": [
    "packages/connect",
    "packages/connect-react"
  ],
  "scripts": {
    "build": "node packages/connect/release/build-sdk.ts",
    "test": "node --test tests/unit/*.test.ts",
    "typecheck": "tsc --noEmit",
    "sdk:check": "node scripts/check-sdk-packages.ts",
    "check": "npm run lint && npm run format:check && npm run check:lines && npm run typecheck && npm test && npm run sdk:check",
    "consumer": "node packages/connect/release/consumer-smoke.ts",
    "sdk:build": "node packages/connect/release/build-sdk.ts",
    "sdk:consumer": "node packages/connect/release/consumer-smoke.ts",
    "sdk:pack": "node scripts/check-sdk-packages.ts --pack-destination .local/sdk-tarballs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:lines": "node scripts/check-source-lines.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jsdom": "26.1.0",
    "jsqr": "1.4.0",
    "next": "16.4.6",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  },
  "version": "0.1.0-alpha.0"
}
